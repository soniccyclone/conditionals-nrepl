{:paths ["src/clojure" "test/clojure"]
 :aliases {:test {:extra-deps {io.github.dmiller/test-runner {:git/url "https://github.com/dmiller/test-runner"
                                                              :git/tag "v0.5.3clr"
                                                              :git/sha "ae91dd2"}
                               io.github.clojure/clr.test.check {:git/url "https://github.com/clojure/clr.test.check"
                                                                 :git/tag "v1.1.4"
                                                                 :git/sha "d21dfc3"}}
                  :exec-fn nrepl.clr-test-runner/run
                  :exec-args {:dirs ["test/clojure"]
                              :nses [nrepl.test-helpers.match-test
                                     nrepl.csharp-helpers-test
                                     nrepl.util.io-test
                                     nrepl.util.runtime-test
                                     nrepl.util.reflect-test
                                     nrepl.util.threading-test
                                     nrepl.bencode-test]}}}}
