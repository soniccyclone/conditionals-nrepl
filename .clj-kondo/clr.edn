{:cljc {:features [:cljs]}
 :linters {:unresolved-namespace {:exclude [Environment System.Environment
                                            System.IO.Path System.IO.File
                                            System.Threading.Thread
                                            System.Array]}
           :unresolved-symbol {:exclude [System byte-array format class String
                                         alter-var-root *err*
                                         promise future deliver Exception with-open read-string
                                         requiring-resolve InvalidOperationException
                                         ArgumentException]}}
 :config-in-ns {nrepl.ack {:linters {:invalid-arity {:level :off}
                                    :unresolved-symbol {:exclude [transport]}}}
                nrepl.bencode {:linters {:unresolved-symbol {:exclude [definline read-byte input buf
                                                                        off len b output s]}}}
                nrepl.cmdline.options {:linters {:unresolved-symbol {:exclude [spit]}
                                                 :unused-binding {:level :off}}}
                nrepl.middleware {:linters {:unresolved-symbol {:exclude [*clojure-version* clojure-version]}}}
                nrepl.middleware.load-file {:linters {:unresolved-symbol {:exclude [*read-eval* *unchecked-math*
                                                                                    *warn-on-reflection* *data-readers*]}}}
                nrepl.misc {:linters {:redefined-var {:level :off}
                                      :unresolved-namespace {:exclude [Int32 System.Guid]}
                                      :unresolved-symbol {:exclude [clojure]}}}
                nrepl.util.completion {:linters {:unresolved-namespace {:exclude [Char StringComparison]}
                                                 :unresolved-symbol {:exclude [*clojure-version* *unchecked-math*
                                                                               Object all-ns class? clojure
                                                                               ns-aliases ns-map]}}}
                nrepl.util.io {:linters {:redefined-var {:level :off}}}
                nrepl.util.lookup {:linters {:unresolved-symbol {:exclude [ns-resolve]}}}}}
