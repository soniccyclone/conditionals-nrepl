ARG JDK=21
FROM docker.io/library/clojure:temurin-${JDK}-noble
ARG CLI_VERSION=
ENV CLOJURE_VERSION=1.12
RUN if [ -n "$CLI_VERSION" ]; then \
      curl -fsSL "https://github.com/clojure/brew-install/releases/download/${CLI_VERSION}/linux-install.sh" -o /tmp/linux-install.sh \
      && bash /tmp/linux-install.sh \
      && rm /tmp/linux-install.sh; \
    fi \
 && clojure --version
WORKDIR /work
