(ns nrepl.socket
  "TCP and unix domain sockets on System.Net.Sockets."
  (:require
   [clojure.string :as str]
   [nrepl.misc :refer [log]]
   [nrepl.tls :as tls])
  (:import
   (System.IO EndOfStreamException IOException Path Stream)
   (System.Net Dns IPAddress IPEndPoint)
   (System.Net.Sockets AddressFamily NetworkStream ProtocolType Socket SocketError
                       SocketException SocketTaskExtensions SocketType TcpListener
                       UnixDomainSocketEndPoint)
   (System.Text Encoding StringBuilder)
   (System.Text.RegularExpressions Match Regex)))

(deftype TcpServer [^TcpListener listener closed])

(deftype UnixServer [^Socket listener ^String path closed])

(defn- try-parse-address
  ^IPAddress [^String host]
  (let [^IPAddress address nil]
    (when (IPAddress/TryParse host (by-ref address))
      address)))

(defn- resolve-address
  ^IPAddress [^String host]
  (or (try-parse-address host)
      (let [addresses (Dns/GetHostAddresses host)]
        (or (first (filter #(= AddressFamily/InterNetwork (.AddressFamily ^IPAddress %))
                           addresses))
            (first addresses)
            (throw (ex-info (str "Cannot resolve host " host)
                            {:nrepl/kind :nrepl.socket/unresolved-host :host host}))))))

(defn inet-socket
  ([bind port]
   (let [port (or port 0)
         bind (or bind "127.0.0.1")
         listener (TcpListener. (resolve-address bind) (int port))]
     (.Start listener)
     (TcpServer. listener (atom false))))
  ([bind port tls-context]
   (let [port (or port 0)
         bind (or bind "127.0.0.1")]
     (tls/server-socket tls-context bind port))))

(def unix-domain-flavor
  (when Socket/OSSupportsUnixDomainSockets
    :dotnet))

(defn- throw-no-sockets
  []
  (let [msg "Filesystem sockets are not supported on this operating system"]
    (log msg)
    (throw (ex-info msg {:nrepl/kind ::no-filesystem-sockets}))))

(defn- unix-endpoint
  ^UnixDomainSocketEndPoint [^String path]
  (when-not unix-domain-flavor
    (throw-no-sockets))
  (try
    (UnixDomainSocketEndPoint. path)
    (catch ArgumentOutOfRangeException e
      (throw (ex-info (str "The unix socket path has an invalid length for this platform ("
                           (count path) " characters, the limit is below 108): " path)
                      {:nrepl/kind ::invalid-socket-path :path path}
                      e)))))

(defn- new-unix-socket
  ^Socket []
  (Socket. AddressFamily/Unix SocketType/Stream ProtocolType/Unspecified))

(defn- absolute-path
  ^String [^String path]
  (cond
    (not (Path/IsPathRooted path)) (Path/Combine Environment/CurrentDirectory path)
    (Path/IsPathFullyQualified path) path
    :else (Path/GetFullPath path)))

(defn unix-server-socket
  [path]
  (let [endpoint (unix-endpoint path)
        sock (new-unix-socket)]
    (try
      (.Bind sock endpoint)
      (.Listen sock (int 50))
      (UnixServer. sock (absolute-path path) (atom false))
      (catch Exception e
        (.Dispose sock)
        (throw e)))))

(defn unix-client-socket
  [path]
  (let [endpoint (unix-endpoint path)
        sock (new-unix-socket)]
    (try
      (.Connect sock endpoint)
      sock
      (catch Exception e
        (.Dispose sock)
        (throw e)))))

(defn closed-exception?
  [e]
  (or (instance? ObjectDisposedException e)
      (and (instance? SocketException e)
           (let [code (.SocketErrorCode ^SocketException e)]
             (or (= SocketError/Interrupted code)
                 (= SocketError/OperationAborted code))))))

(defn listener-closed?
  [s]
  (boolean (if (instance? UnixServer s)
             @(.closed ^UnixServer s)
             @(.closed ^TcpServer s))))

(defn close-listener!
  [s]
  (if (instance? UnixServer s)
    (let [^UnixServer s s]
      (reset! (.closed s) true)
      (.Dispose ^Socket (.listener s)))
    (let [^TcpServer s s]
      (reset! (.closed s) true)
      (.Stop ^TcpListener (.listener s))))
  nil)

(defn- throw-closed
  []
  (throw (ObjectDisposedException. "The nREPL listener is closed")))

(def ^:private accept-task-type
  (symbol "System.Threading.Tasks.Task`1[System.Net.Sockets.Socket]"))

(defmacro ^:private with-accept-task
  [[sym expr] & body]
  `(let [~(with-meta sym {:tag accept-task-type}) ~expr]
     ~@body))

(defn- accept-unix
  ^Socket [^Socket listener]
  (with-accept-task [task (SocketTaskExtensions/AcceptAsync listener)]
    (try
      (.Wait task)
      (.Result task)
      (catch AggregateException e
        (throw (or (.InnerException e) e))))))

(defn accept
  [s]
  (try
    (if (instance? UnixServer s)
      (accept-unix (.listener ^UnixServer s))
      (.AcceptSocket ^TcpListener (.listener ^TcpServer s)))
    (catch Exception e
      (if (listener-closed? s)
        (throw-closed)
        (throw e)))))

(defn local-port
  [s]
  (if (instance? UnixServer s)
    -1
    (.Port ^IPEndPoint (.LocalEndpoint ^TcpListener (.listener ^TcpServer s)))))

(def ^:private hostname-re
  #"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\.?")

(def ^:private zone-re
  #"[A-Za-z0-9._~-]+")

(def ^:private uri-safe-chars
  "-_.!~*'();/?:@&=+$,")

(defn- ipv6-literal?
  [^String s]
  (let [zone-at (.IndexOf s "%" StringComparison/Ordinal)
        address (if (neg? zone-at) s (subs s 0 zone-at))
        parsed (try-parse-address address)]
    (boolean
     (and parsed
          (= AddressFamily/InterNetworkV6 (.AddressFamily parsed))
          (or (neg? zone-at)
              (re-matches zone-re (subs s (inc zone-at))))))))

(defn- invalid-uri
  [what value]
  (System.UriFormatException. (str "Invalid " what " in an nREPL URI: " (pr-str value))))

(defn- uri-host-text
  [^String host]
  (cond
    (str/blank? host) (throw (invalid-uri "host" host))
    (re-matches hostname-re host) host
    :else (let [bracketed? (and (= \[ (first host)) (= \] (last host)))
                bare (if bracketed? (subs host 1 (dec (count host))) host)]
            (if (ipv6-literal? bare)
              (str "[" bare "]")
              (throw (invalid-uri "host" host))))))

(defn- ascii-char?
  [c]
  (< (int c) 128))

(defn- uri-safe?
  [c]
  (let [c (char c)]
    (or (and (ascii-char? c) (Char/IsAsciiLetterOrDigit c))
        (>= (.IndexOf ^String uri-safe-chars c) 0))))

(defn- percent-encode
  ^String [^String s]
  (let [sb (StringBuilder.)]
    (doseq [b (.GetBytes Encoding/UTF8 s)]
      (.Append sb (str "%" (.ToString (int b) "X2"))))
    (str sb)))

(defn- uri-quote
  [^String s ascii?]
  (let [sb (StringBuilder.)]
    (doseq [c s]
      (cond
        (uri-safe? c) (.Append sb c)
        (ascii-char? c) (.Append sb (percent-encode (str c)))
        (or (Char/IsSeparator (char c)) (Char/IsControl (char c))) (.Append sb (percent-encode (str c)))
        :else (.Append sb c)))
    (let [quoted (str sb)]
      (if ascii?
        (str/replace (.Normalize ^String quoted)
                     #"[^\x00-\x7F]+"
                     (fn [run] (percent-encode run)))
        quoted))))

(defn- nrepl-uri-text
  [{:keys [host server-socket]} transport-scheme ascii?]
  (cond
    (instance? UnixServer server-socket)
    (str transport-scheme "+unix:" (uri-quote (.path ^UnixServer server-socket) ascii?))

    (instance? TcpServer server-socket)
    (str transport-scheme "://" (uri-host-text host) ":" (local-port server-socket))

    :else
    (throw (ex-info "URI text for this kind of server is not supported on ClojureCLR"
                    {:nrepl/kind :nrepl.socket/unsupported}))))

(defn as-nrepl-uri
  [server transport-scheme]
  (nrepl-uri-text server transport-scheme false))

(defn as-nrepl-uri-string
  [server transport-scheme]
  (nrepl-uri-text server transport-scheme true))

(def ^:private uri-re
  (Regex. "^(?:([A-Za-z][A-Za-z0-9+.-]*):)?(?://([^/?#]*))?([^?#]*)(?:\\?([^#]*))?(?:#(.*))?$"))

(def ^:private illegal-uri-char-re
  #"[\x00-\x20\x7F-\x9F\p{Z}\"<>\\^`{|}]|%(?![0-9A-Fa-f]{2})")

(def ^:private authority-re
  #"(?:[^@]*@)?(\[[^\]]+\]|[^:@\[\]]*)(?::([0-9]{0,9}))?")

(defn- match-group
  [^Match m n]
  (let [g (.get_Item (.Groups m) (int n))]
    (when (.Success g)
      (.Value g))))

(defn- server-authority
  [authority]
  (when-let [[_ host port] (and authority (re-matches authority-re authority))]
    (when (or (re-matches hostname-re host)
              (and (= \[ (first host)) (ipv6-literal? (subs host 1 (dec (count host))))))
      {:host host
       :port (if (= "" port) -1 (Int32/Parse ^String port))})))

(defn parse-uri
  [s]
  (let [^String text (if (instance? System.Uri s)
                       (.OriginalString ^System.Uri s)
                       s)
        m (.Match ^Regex uri-re text)
        scheme (match-group m 1)
        authority (match-group m 2)
        path (match-group m 3)
        query (match-group m 4)
        fragment (match-group m 5)]
    (when (or (re-find illegal-uri-char-re text)
              (some #(and % (re-find #"[\[\]]" %)) [path query fragment])
              (and scheme (not authority) (= "" path) (not query) (not fragment)))
      (throw (invalid-uri "URI" text)))
    (let [{:keys [host port]} (server-authority authority)]
      {:scheme scheme
       :host host
       :port (or port -1)})))

(defprotocol Connectable
  (is-connected? [s]
    "Returns true if socket-like thing `s` is currently connected."))

(extend-type Socket
  Connectable
  (is-connected? [s] (.Connected s)))

(defn disconnected-exception
  [msg]
  (IOException. ^String msg (SocketException. (int SocketError/ConnectionAborted))))

(defn- disconnection-code?
  [e]
  (let [code (.SocketErrorCode ^SocketException e)]
    (or (= SocketError/ConnectionAborted code)
        (= SocketError/ConnectionReset code)
        (= SocketError/Shutdown code))))

(defn disconnected?
  [e]
  (cond
    (instance? EndOfStreamException e) true
    (instance? SocketException e) (disconnection-code? e)
    (instance? IOException e) (let [cause (.InnerException ^IOException e)]
                                (and (instance? SocketException cause)
                                     (disconnection-code? cause)))
    :else false))

(defn connect
  [host port]
  (let [sock (Socket. SocketType/Stream ProtocolType/Tcp)]
    (try
      (.Connect sock ^String host (int port))
      sock
      (catch Exception e
        (.Dispose sock)
        (throw e)))))

(defn close-connection!
  [s]
  (.Dispose ^Socket s))

(def ^:private weak-table-type
  (symbol "System.Runtime.CompilerServices.ConditionalWeakTable`2[System.Net.Sockets.Socket,System.Net.Sockets.NetworkStream]"))

(defmacro ^:private new-weak-table
  []
  `(new ~weak-table-type))

(defmacro ^:private with-weak-table
  [[sym] & body]
  `(let [~(with-meta sym {:tag weak-table-type}) ~sym]
     ~@body))

(def ^:private socket-streams
  (new-weak-table))

(defn- lookup-stream
  ^NetworkStream [table ^Socket sock]
  (with-weak-table [table]
    (let [^NetworkStream stream nil]
      (when (.TryGetValue table sock (by-ref stream))
        stream))))

(defn- socket-stream
  ^NetworkStream [^Socket sock]
  (locking sock
    (or (lookup-stream socket-streams sock)
        (let [stream (NetworkStream. sock true)]
          (with-weak-table [socket-streams]
            (.Add socket-streams sock stream))
          stream))))

(defprotocol AsBufferedInputStreamSubset
  (buffered-input [x]
    "Returns the byte stream the reader thread reads from x."))

(defprotocol AsBufferedOutputStreamSubset
  (buffered-output [x]
    "Returns the byte stream writes to x go to."))

(extend-protocol AsBufferedInputStreamSubset
  Socket
  (buffered-input [s] (socket-stream s))
  Stream
  (buffered-input [s] s))

(extend-protocol AsBufferedOutputStreamSubset
  Socket
  (buffered-output [s] (socket-stream s))
  Stream
  (buffered-output [s] s))

(defn write
  ([^Stream out ^bytes buf]
   (.Write out buf (int 0) (int (alength buf))))
  ([^Stream out ^bytes buf offset length]
   (.Write out buf (int offset) (int length))))
