(ns nrepl.socket-clr-test
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest testing is]]
            [nrepl.socket :as sut]
            [nrepl.test-helpers :as th]
            [nrepl.test-helpers.bounded :as bounded]
            [nrepl.util.io :as io])
  (:import (System.IO EndOfStreamException IOException Stream)
           (System.Net IPAddress)
           (System.Net.Sockets LingerOption NetworkStream Socket SocketError
                               SocketException TcpListener)
           (System.Threading Thread)))

(defn- socket-exception [code]
  (SocketException. (int code)))

(defn- wrapped [code]
  (IOException. "wrapped" ^Exception (socket-exception code)))

(defn- with-pair
  [f]
  (let [listener (sut/inet-socket "127.0.0.1" 0)
        client (sut/connect "127.0.0.1" (sut/local-port listener))
        server (sut/accept listener)]
    (try
      (f client server)
      (finally
        (sut/close-connection! client)
        (sut/close-connection! server)
        (sut/close-listener! listener)))))

(defn- read-text
  [^System.IO.Stream in n]
  (let [buf (byte-array n)]
    (loop [off 0]
      (when (< off n)
        (let [k (.Read in buf (int off) (int (- n off)))]
          (when (pos? k)
            (recur (+ off k))))))
    (io/utf8-string buf)))

(defn- caught [f]
  (try (f) nil (catch Exception e e)))

(defn- bounded-caught [f]
  (let [r (bounded/bounded #(caught f))]
    (is (not= ::bounded/timeout r))
    r))

(defn- await-caught [handle]
  (let [r (bounded/await-result handle)]
    (is (not= ::bounded/timeout r))
    r))

(deftest disconnected-exception-test
  (testing "disconnected-exception builds an exception that disconnected? recognises"
    (let [e (sut/disconnected-exception "gone")]
      (is (instance? IOException e))
      (is (sut/disconnected? e))
      (is (= "gone" (ex-message e)))))

  (testing "disconnected? is false for other exceptions"
    (is (not (sut/disconnected? (IOException. "gone"))))
    (is (not (sut/disconnected? (ObjectDisposedException. "gone"))))
    (is (not (sut/disconnected? (wrapped SocketError/TimedOut))))
    (is (not (sut/disconnected? (socket-exception SocketError/TimedOut))))
    (is (not (sut/disconnected? nil)))))

(deftest disconnected-predicate-test
  (testing "an IOException wrapping an aborted, reset or shut down connection"
    (is (sut/disconnected? (wrapped SocketError/ConnectionAborted)))
    (is (sut/disconnected? (wrapped SocketError/ConnectionReset)))
    (is (sut/disconnected? (wrapped SocketError/Shutdown))))

  (testing "the same socket errors raised directly"
    (is (sut/disconnected? (socket-exception SocketError/ConnectionAborted)))
    (is (sut/disconnected? (socket-exception SocketError/ConnectionReset)))
    (is (sut/disconnected? (socket-exception SocketError/Shutdown))))

  (testing "the end of a stream"
    (is (sut/disconnected? (EndOfStreamException. "eof")))))

(deftest closed-exception-test
  (testing "closed-exception? recognises what a closed listener or socket raises"
    (is (sut/closed-exception? (ObjectDisposedException. "closed")))
    (is (sut/closed-exception? (socket-exception SocketError/Interrupted)))
    (is (sut/closed-exception? (socket-exception SocketError/OperationAborted))))

  (testing "closed-exception? is false for other exceptions"
    (is (not (sut/closed-exception? (socket-exception SocketError/ConnectionReset))))
    (is (not (sut/closed-exception? (IOException. "gone"))))
    (is (not (sut/closed-exception? (InvalidOperationException. "gone"))))
    (is (not (sut/closed-exception? (sut/disconnected-exception "gone"))))
    (is (not (sut/closed-exception? nil)))))

(deftest tcp-listener-test
  (let [ss (sut/inet-socket "127.0.0.1" 0)]
    (try
      (testing "local-port is the bound port"
        (is (pos? (sut/local-port ss))))

      (testing "as-nrepl-uri-string is the uri text of the listener"
        (is (= (str "nrepl://127.0.0.1:" (sut/local-port ss))
               (sut/as-nrepl-uri-string {:host "127.0.0.1" :server-socket ss} "nrepl")))
        (is (= (str "nrepl+edn://[::1]:" (sut/local-port ss))
               (sut/as-nrepl-uri-string {:host "::1" :server-socket ss} "nrepl+edn"))))

      (testing "connect opens a client connection that close-connection! closes"
        (let [^Socket client (sut/connect "127.0.0.1" (sut/local-port ss))]
          (is (sut/is-connected? client))
          (sut/close-connection! client)
          (is (not (sut/is-connected? client)))
          (is (thrown? ObjectDisposedException (.Send client ^bytes (byte-array 1))))))

      (testing "listener-closed? follows close-listener!"
        (is (not (sut/listener-closed? ss)))
        (sut/close-listener! ss)
        (is (sut/listener-closed? ss))
        (sut/close-listener! ss)
        (is (sut/listener-closed? ss)))
      (finally
        (sut/close-listener! ss)))))

(deftest inet-socket-bind-test
  (testing "no bind address and no port means loopback on a free port"
    (let [ss (sut/inet-socket nil nil)]
      (try
        (is (pos? (sut/local-port ss)))
        (sut/close-connection! (sut/connect "127.0.0.1" (sut/local-port ss)))
        (finally (sut/close-listener! ss)))))

  (testing "a host name binds an IPv4 address even though localhost resolves to ::1 first"
    (let [ss (sut/inet-socket "localhost" 0)]
      (try
        (sut/close-connection! (sut/connect "127.0.0.1" (sut/local-port ss)))
        (finally (sut/close-listener! ss)))))

  (testing "a numeric address is used as given"
    (let [ss (sut/inet-socket "0.0.0.0" 0)]
      (try
        (sut/close-connection! (sut/connect "127.0.0.1" (sut/local-port ss)))
        (finally (sut/close-listener! ss)))))

  (testing "a second listener cannot take a port that is in use"
    (let [ss (sut/inet-socket "127.0.0.1" 0)]
      (try
        (let [e (caught #(sut/inet-socket "127.0.0.1" (sut/local-port ss)))]
          (is (instance? SocketException e))
          (is (= SocketError/AddressAlreadyInUse (.SocketErrorCode ^SocketException e))))
        (finally (sut/close-listener! ss)))))

  (testing "an unresolvable host fails with the resolver's SocketException"
    (let [e (caught #(sut/inet-socket "no-such-host.invalid" 0))]
      (is (instance? SocketException e))
      (is (= SocketError/HostNotFound (.SocketErrorCode ^SocketException e))))))

(deftest raw-listener-behaviour-after-stop
  (testing "a blocked AcceptSocket throws Interrupted after Stop, later calls InvalidOperationException"
    (let [listener (TcpListener. IPAddress/Loopback (int 0))]
      (.Start listener)
      (let [blocked (bounded/spawn #(caught (fn [] (.AcceptSocket listener))))]
        (bounded/sleep-ms 200)
        (.Stop listener)
        (let [e (await-caught blocked)]
          (is (instance? SocketException e))
          (is (= SocketError/Interrupted (.SocketErrorCode ^SocketException e)))))
      (is (instance? InvalidOperationException (caught #(.AcceptSocket listener)))))))

(deftest accept-test
  (testing "accept returns the connected server side of a client connection"
    (with-pair
      (fn [^Socket client ^Socket server]
        (is (sut/is-connected? server))
        (is (sut/is-connected? client)))))

  (testing "accept on a closed listener throws something closed-exception? recognises"
    (let [listener (sut/inet-socket "127.0.0.1" 0)]
      (sut/close-listener! listener)
      (let [e (caught #(sut/accept listener))]
        (is (sut/closed-exception? e))
        (is (not (sut/disconnected? e))))))

  (testing "closing the listener under a blocked accept throws something closed-exception? recognises"
    (let [listener (sut/inet-socket "127.0.0.1" 0)
          blocked (bounded/spawn #(caught (fn [] (sut/accept listener))))]
      (bounded/sleep-ms 200)
      (sut/close-listener! listener)
      (let [e (await-caught blocked)]
        (is (sut/closed-exception? e))
        (is (sut/listener-closed? listener)))))

  (testing "a connection accepted before the listener closed keeps working"
    (let [listener (sut/inet-socket "127.0.0.1" 0)
          client (sut/connect "127.0.0.1" (sut/local-port listener))
          server (sut/accept listener)]
      (try
        (sut/close-listener! listener)
        (sut/write (sut/buffered-output client) (io/utf8-bytes "ok"))
        (let [^System.IO.Stream in (sut/buffered-input server)]
          (is (= (int \o) (.ReadByte in)))
          (is (= (int \k) (.ReadByte in))))
        (finally
          (sut/close-connection! client)
          (sut/close-connection! server))))))

(deftest streams-test
  (testing "both directions share one NetworkStream per socket"
    (with-pair
      (fn [^Socket client ^Socket server]
        (is (instance? NetworkStream (sut/buffered-output client)))
        (is (identical? (sut/buffered-output client) (sut/buffered-output client)))
        (is (not (identical? (sut/buffered-output client) (sut/buffered-output server)))))))

  (testing "write sends the whole array, or the given slice"
    (with-pair
      (fn [^Socket client ^Socket server]
        (let [out (sut/buffered-output client)
              in (sut/buffered-input server)]
          (sut/write out (io/utf8-bytes "abc"))
          (sut/write out (io/utf8-bytes "xdefz") 1 3)
          (is (= "abcdef" (read-text in 6)))))))

  (testing "a text reader over a socket's input gets what has arrived instead of waiting to fill its buffer"
    (with-pair
      (fn [^Socket client ^Socket server]
        (sut/write (sut/buffered-output client) (io/utf8-bytes (apply str (repeat 3000 "x"))))
        (let [reader (io/text-reader (sut/buffered-input server))]
          (is (= 3000 (bounded/bounded
                       #(loop [n 0]
                          (if (< n 3000)
                            (do (.Read ^System.IO.TextReader reader)
                                (recur (inc n)))
                            n)))))))))

  (testing "a stream passes through as its own input and output"
    (let [ms (System.IO.MemoryStream.)]
      (is (identical? ms (sut/buffered-input ms)))
      (is (identical? ms (sut/buffered-output ms)))
      (sut/write ms (io/utf8-bytes "hello"))
      (sut/write ms (io/utf8-bytes "hello") 1 2)
      (is (= "helloel" (io/utf8-string (.ToArray ms)))))))

(deftest read-after-disconnection-test
  (testing "a peer that closes cleanly ends the stream"
    (with-pair
      (fn [^Socket client ^Socket server]
        (let [^Stream in (sut/buffered-input server)]
          (sut/close-connection! client)
          (is (= -1 (bounded/bounded #(.ReadByte in))))))))

  (testing "closing a socket under a blocked reader throws a disconnection"
    (with-pair
      (fn [_client ^Socket server]
        (let [^Stream in (sut/buffered-input server)
              blocked (bounded/spawn #(caught (fn [] (.ReadByte in))))]
          (bounded/sleep-ms 200)
          (sut/close-connection! server)
          (let [e (await-caught blocked)]
            (is (instance? IOException e))
            (is (instance? SocketException (.InnerException ^Exception e)))
            (is (= SocketError/ConnectionAborted
                   (.SocketErrorCode ^SocketException (.InnerException ^Exception e))))
            (is (sut/disconnected? e))
            (is (not (sut/is-connected? server))))))))

  (testing "a peer that resets the connection throws a disconnection"
    (with-pair
      (fn [^Socket client ^Socket server]
        (let [^Stream in (sut/buffered-input server)]
          (set! (.LingerState client) (LingerOption. true 0))
          (sut/close-connection! client)
          (let [e (bounded-caught #(.ReadByte in))]
            (is (instance? IOException e))
            (is (sut/disconnected? e)))))))

  (testing "writing to a peer that has gone throws a disconnection"
    (with-pair
      (fn [^Socket client ^Socket server]
        (let [out (sut/buffered-output server)
              chunk (byte-array 65536)]
          (sut/close-connection! client)
          (let [e (loop [n 0]
                    (or (bounded/bounded #(caught (fn [] (sut/write out chunk))))
                        (when (< n 100)
                          (bounded/sleep-ms 20)
                          (recur (inc n)))))]
            (is (instance? IOException e))
            (is (sut/disconnected? e))
            (is (not (sut/is-connected? server)))))))))

(deftest graceful-close-test
  (testing "a socket io/close! closes under a blocked reader still delivers what was written, then ends the peer's stream"
    (with-pair
      (fn [^Socket client ^Socket server]
        (let [^Stream in (sut/buffered-input server)
              blocked (bounded/spawn #(caught (fn [] (.ReadByte in))))]
          (sut/write (sut/buffered-output server) (io/utf8-bytes "bye"))
          (bounded/sleep-ms 200)
          (io/close! server)
          (let [^Stream peer-in (sut/buffered-input client)]
            (is (= "bye" (read-text peer-in 3)))
            (is (= -1 (bounded/bounded #(.ReadByte peer-in)))))
          (await-caught blocked))))))

(deftest connect-failure-test
  (testing "connecting to a port nobody listens on throws a refused SocketException"
    (let [listener (sut/inet-socket "127.0.0.1" 0)
          port (sut/local-port listener)]
      (sut/close-listener! listener)
      (let [e (caught #(sut/connect "127.0.0.1" port))]
        (is (instance? SocketException e))
        (is (= SocketError/ConnectionRefused (.SocketErrorCode ^SocketException e)))))))

(deftest unsupported-uri-test
  (testing "the URI text of a listener that is neither TCP nor unix is unsupported"
    (let [e (caught #(sut/as-nrepl-uri-string {:host nil :server-socket :nothing} "nrepl"))]
      (is (instance? clojure.lang.ExceptionInfo e))
      (is (= :nrepl.socket/unsupported (:nrepl/kind (ex-data e)))))))

(defn- with-temp-dir
  [f]
  (let [dir (th/make-temp-dir "nrepl-sock-")]
    (try
      (f dir)
      (finally
        (th/delete-recursively! dir)))))

(deftest unix-listener-test
  (when sut/unix-domain-flavor
    (testing "the flavor names the .NET sockets"
      (is (= :dotnet sut/unix-domain-flavor)))

    (testing "the socket file exists while the listener is open and is removed when it closes"
      (with-temp-dir
        (fn [dir]
          (let [path (th/path-join dir "listener")
                ss (sut/unix-server-socket path)]
            (try
              (is (th/path-exists? path))
              (is (= -1 (sut/local-port ss)))
              (sut/close-listener! ss)
              (is (not (th/path-exists? path)))
              (finally
                (sut/close-listener! ss)))))))

    (testing "a file left at the path blocks the bind with AddressAlreadyInUse"
      (with-temp-dir
        (fn [dir]
          (let [path (th/path-join dir "stale")]
            (spit path "left behind")
            (let [e (caught #(sut/unix-server-socket path))]
              (is (instance? SocketException e))
              (is (= SocketError/AddressAlreadyInUse (.SocketErrorCode ^SocketException e))))))))

    (testing "closing the listener under a blocked accept throws something closed-exception? recognises"
      (with-temp-dir
        (fn [dir]
          (let [ss (sut/unix-server-socket (th/path-join dir "blocked"))
                blocked (bounded/spawn #(caught (fn [] (sut/accept ss))))]
            (bounded/sleep-ms 200)
            (sut/close-listener! ss)
            (let [e (await-caught blocked)]
              (is (sut/closed-exception? e))
              (is (sut/listener-closed? ss)))))))

    (testing "a connection accepted before the listener closed keeps working, in both directions"
      (with-temp-dir
        (fn [dir]
          (let [path (th/path-join dir "pair")
                ss (sut/unix-server-socket path)
                client (sut/unix-client-socket path)
                server (sut/accept ss)]
            (try
              (sut/close-listener! ss)
              (sut/write (sut/buffered-output client) (io/utf8-bytes "ping"))
              (is (= "ping" (read-text (sut/buffered-input server) 4)))
              (sut/write (sut/buffered-output server) (io/utf8-bytes "pong"))
              (is (= "pong" (read-text (sut/buffered-input client) 4)))
              (finally
                (sut/close-connection! client)
                (sut/close-connection! server)))))))

    (testing "a peer that closes cleanly ends the stream, and closing under a blocked reader is a disconnection"
      (with-temp-dir
        (fn [dir]
          (let [path (th/path-join dir "eof")
                ss (sut/unix-server-socket path)
                client (sut/unix-client-socket path)
                server (sut/accept ss)]
            (try
              (let [^Stream in (sut/buffered-input server)
                    blocked (bounded/spawn #(caught (fn [] (.ReadByte in))))]
                (bounded/sleep-ms 200)
                (sut/close-connection! server)
                (let [e (await-caught blocked)]
                  (is (sut/disconnected? e))))
              (is (= -1 (bounded/bounded #(.ReadByte ^Stream (sut/buffered-input client)))))
              (finally
                (sut/close-connection! client)
                (sut/close-listener! ss)))))))))

(deftest unix-socket-path-test
  (when sut/unix-domain-flavor
    (testing "a path over the platform limit is reported with the path and a kind, and creates nothing"
      (with-temp-dir
        (fn [dir]
          (let [path (th/path-join dir (apply str (repeat 120 "a")))
                e (caught #(sut/unix-server-socket path))]
            (is (instance? clojure.lang.ExceptionInfo e))
            (is (= :nrepl.socket/invalid-socket-path (:nrepl/kind (ex-data e))))
            (is (= path (:path (ex-data e))))
            (is (str/includes? (ex-message e) "invalid length"))
            (is (not (th/path-exists? path)))
            (let [e (caught #(sut/unix-client-socket path))]
              (is (= :nrepl.socket/invalid-socket-path (:nrepl/kind (ex-data e)))))))))

    (testing "a relative path is reported as an absolute one"
      (with-temp-dir
        (fn [dir]
          (let [previous Environment/CurrentDirectory]
            (try
              (set! Environment/CurrentDirectory dir)
              (let [ss (sut/unix-server-socket "relative.sock")]
                (try
                  (is (th/path-exists? (th/path-join dir "relative.sock")))
                  (is (= (str "nrepl+unix:" (str/replace (th/path-join Environment/CurrentDirectory "relative.sock")
                                                         "\\" "%5C"))
                         (sut/as-nrepl-uri-string {:host nil :server-socket ss} "nrepl")))
                  (finally
                    (sut/close-listener! ss))))
              (finally
                (set! Environment/CurrentDirectory previous)))))))

    (when-not th/win?
      (testing "a non-ASCII path is percent-encoded as UTF-8 in the ASCII text and kept in the plain text"
        (with-temp-dir
          (fn [dir]
            (doseq [[name ascii plain] [["\u00e9" "%C3%A9" "\u00e9"]
                                        ["e\u0301" "%C3%A9" "e\u0301"]
                                        ["\u65e5\u672c" "%E6%97%A5%E6%9C%AC" "\u65e5\u672c"]
                                        ["\ud83d\ude00" "%F0%9F%98%80" "\ud83d\ude00"]
                                        ["a\u00a0b" "a%C2%A0b" "a%C2%A0b"]
                                        ["a\tb" "a%09b" "a%09b"]]]
              (let [path (th/path-join dir name)
                    ss (sut/unix-server-socket path)
                    prefix (str "nrepl+unix:" (str/replace dir "\\" "%5C") (str/replace th/sys-file-sep "\\" "%5C"))]
                (try
                  (is (= (str prefix ascii)
                         (sut/as-nrepl-uri-string {:host nil :server-socket ss} "nrepl"))
                      (pr-str name))
                  (is (= (str prefix plain)
                         (str (sut/as-nrepl-uri {:host nil :server-socket ss} "nrepl")))
                      (pr-str name))
                  (finally
                    (sut/close-listener! ss)))))))))))
